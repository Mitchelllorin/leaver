{
  "name": "orrery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Orrery - an explorable, educational solar system: real orbital mechanics, procedural worlds, first-person flight and landing.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs && node scripts/check-ui.mjs",
    "check:sim": "node scripts/check.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
